// LeadCRM - Prisma Schema
// Single source of truth for all database models
// ORM: Prisma 5 | DB: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ENUMS
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ

enum TenantStatus {
  SANDBOX
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContactStatus {
  HOT
  WARM
  COLD
  CANCELLED
  CLOSED
}

// System-owned lifecycle position ΓÇö never manually editable via status controls.
// REQ131: ContactStatus (above) is human-owned and never changed by automation.
// This enum is the system-owned complement.
enum ContactLifecycleStage {
  LEAD // captured, not yet qualified
  QUALIFIED // qualified, ready for opportunity
  CONTACT // known person, active relationship
  CUSTOMER // has at least one won deal
  CHURNED // former customer, no active deals
  DISQUALIFIED // dead ΓÇö will not proceed
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignType {
  EMAIL
  SMS
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SCHEDULED
}

// Actions that can be manually performed on a deal
enum DealActionType {
  UPDATE_FIELD
  ASSIGN_AGENT
  CHANGE_STATUS
  SEND_EMAIL
  SEND_SMS
  ADD_NOTE
  CREATE_TASK
  CHANGE_STAGE
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// SYSTEM ADMIN (cross-tenant ΓÇö LeadCRM operators)
// No tenantId ΓÇö these users own the platform itself
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model SystemAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PRICING PLAN (global ΓÇö not tenant-scoped)
// Managed by SystemAdmin, consumed by Subscription
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model PricingPlan {
  id             String   @id @default(uuid())
  name           String   @unique // "Free" | "Pro" | "Enterprise"
  planType       PlanType
  monthlyPrice   Float    @default(0)
  quarterlyPrice Float    @default(0)
  annualPrice    Float    @default(0)
  maxUsers       Int?
  maxContacts    Int?
  maxDeals       Int?
  storageLimit   Int? // MB
  isActive       Boolean  @default(true)
  // ── Stripe ────────────────────────────────────────────────────────
  stripeProductId        String?  @unique  // prod_xxx — one Product per plan
  stripeMonthlyPriceId   String?  @unique  // price_xxx for monthly billing
  stripeQuarterlyPriceId String?  @unique  // price_xxx for quarterly billing
  stripeAnnualPriceId    String?  @unique  // price_xxx for annual billing
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PLAN FEATURE
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model PlanFeature {
  id          String  @id @default(uuid())
  planId      String
  name        String // e.g. "Workflow Automation", "Gmail Integration"
  description String?

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TENANT
// plan/subscriptionStatus are denormalized caches for fast plan-gating.
// Subscription is the authoritative billing source.
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Tenant {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  industry           String?
  companySize        String? // "1-10" | "11-50" | "51-200" | "200+"
  email              String?
  phone              String?
  address            String?
  status             TenantStatus       @default(SANDBOX)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  plan               PlanType           @default(FREE) // denorm cache ΓÇö source of truth = Subscription
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  maxUsers           Int?
  maxContacts        Int?
  maxDeals           Int?
  approvedById       String? // SystemAdmin id who approved
  approvedAt         DateTime?
  // ── Stripe ────────────────────────────────────────────────────────
  stripeCustomerId   String?  @unique   // cus_xxx — one customer per tenant
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users              User[]
  userRoles          UserRole[]
  roleDefinitions    RoleDefinition[]
  sessions           Session[]
  invitations        TenantInvitation[]
  subscriptions      Subscription[]
  paymentMethods     PaymentMethod[]
  organizations      Account[]
  leads              Lead[]
  customers          Customer[]
  pipelines          Pipeline[]
  stages             Stage[]
  deals              Deal[]
  dealActions        DealAction[]
  leadDeals          LeadDeal[]
  customerDeals      CustomerDeal[]
  dealStageHistories DealStageHistory[]
  tasks              Task[]
  activities         Activity[]
  campaigns          Campaign[]
  campaignContacts   CampaignContact[]
  campaignMetrics    CampaignMetrics[]
  templates          Template[]
  targetAudiences    TargetAudience[]
  workflows          Workflow[]
  wfTriggerRecords   WorkflowTriggerRecord[]
  wfExecutionRuns    WorkflowExecutionRun[]
  wfExecutionSteps   WorkflowExecutionStep[]
  invoices           Invoice[]
  paymentTxns        PaymentTransaction[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  emailDeliveryLogs  EmailDeliveryLog[]
  documents          TenantDocument[]
  environments       Environment[]
  SMSQueue           SMSQueue[]
  EmailEvent         EmailEvent[]
  AutomationRule     AutomationRule[]
  userPreferences    UserPreference[]
  tenantPreferences  TenantPreference[]
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// SUBSCRIPTION (billing source of truth)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Subscription {
  id              String             @id @default(uuid())
  tenantId        String
  planId          String
  billingCycle    BillingCycle
  status          SubscriptionStatus @default(TRIAL)
  amount          Float
  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  cancelledAt     DateTime?
  // ── Stripe ────────────────────────────────────────────────────────
  stripeSubscriptionId   String?  @unique  // sub_xxx
  stripeCheckoutSessionId String?          // cs_xxx — transient, kept for audit trail
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  plan     PricingPlan @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId, status])
  @@index([stripeSubscriptionId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PAYMENT METHOD (saved methods per tenant)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model PaymentMethod {
  id            String   @id @default(uuid())
  tenantId      String
  methodName    String // "GCash" | "Maya" | "Credit Card" | "Bank Transfer"
  accountName   String?
  accountNumber String? // masked ΓÇö e.g. "****1234"
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  transactions PaymentTransaction[]

  @@index([tenantId, isActive])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// USER
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model User {
  id            String     @id @default(uuid())
  tenantId      String
  email         String
  firstName     String
  lastName      String
  passwordHash  String?   // nullable — OAuth-only users have no password
  phone         String?
  jobTitle      String?
  department    String?
  avatarUrl     String?
  timeZone      String?
  lastLoginAt   DateTime?
  // role kept as String for JWT compatibility during UserRole migration.
  // New code should read role from UserRole junction; this is the legacy fallback.
  role          String     @default("Sales Rep")
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  sessions           Session[]
  invitationsSent    TenantInvitation[] @relation("InvitedByUser")
  organizationsOwned Account[]
  assignedLeads        Lead[]             @relation("AssignedLeads")
  createdLeads         Lead[]             @relation("CreatedLeads")
  updatedLeads         Lead[]             @relation("UpdatedLeads")
  assignedCustomers    Customer[]         @relation("AssignedCustomers")

  assignedDeals        Deal[]             @relation("AssignedDeals")
  ownedDeals           Deal[]             @relation("OwnedDeals")
  leadDealsAdded       LeadDeal[]
  customerDealsAdded   CustomerDeal[]
  dealStageHistories   DealStageHistory[]
  dealActionsPerformed DealAction[]
  assignedTasks        Task[]             @relation("AssignedTasks")
  tasksAssignedByMe    Task[]             @relation("TaskAssignedBy")
  completedTasks       Task[]             @relation("TaskCompletedBy")
  activitiesCreated    Activity[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  oauthAccounts        OAuthAccount[]
  userPreferences      UserPreference[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ROLE DEFINITION
// permissions String[] removed ΓÇö use RolePermission table instead
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model RoleDefinition {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  isSystemRole Boolean  @default(false)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  invitations TenantInvitation[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId, isArchived])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ROLE PERMISSION (per-module CRUD flags)
// One row per module per role.
// module examples: contacts | deals | campaigns | workflows | billing | reports | users | settings
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model RolePermission {
  id        String  @id @default(uuid())
  tenantId  String
  roleId    String
  module    String // e.g. "contacts", "deals", "campaigns"
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
  @@index([tenantId, module])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// USER ROLE (JUNCTION)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model UserRole {
  id       String @id @default(uuid())
  userId   String
  roleId   String
  tenantId String

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId, tenantId])
  @@index([userId, tenantId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// SESSION (Token Revocation)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Session {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique // SHA-256 of JWT, never plaintext
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
  @@index([tokenHash])
}

// ─────────────────────────────────────────────
// OAUTH ACCOUNT
// Links a social provider account to a LeadCRM user.
// One user can have multiple OAuth providers linked.
// ─────────────────────────────────────────────
model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  tenantId          String
  provider          String    // "google" | "github" | "microsoft"
  providerAccountId String    // subject claim from the OAuth provider (immutable)
  accessToken       String?   // encrypted at rest — short-lived
  refreshToken      String?   // encrypted at rest — long-lived
  idToken           String?   // raw OIDC id_token for verification
  tokenType         String?   // "Bearer"
  scope             String?   // e.g. "openid email profile"
  expiresAt         DateTime? // access token expiry
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One provider account can only be linked to one user
  @@unique([provider, providerAccountId])
  @@index([userId, tenantId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TENANT INVITATION
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model TenantInvitation {
  id          String    @id @default(uuid())
  tenantId    String
  email       String
  roleId      String
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  invitedBy User           @relation("InvitedByUser", fields: [invitedById], references: [id])
  role      RoleDefinition @relation(fields: [roleId], references: [id])

  @@index([token])
  @@index([email, tenantId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TENANT DOCUMENT (onboarding files, contracts, etc.)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model TenantDocument {
  id           String    @id @default(uuid())
  tenantId     String
  fileName     String
  documentType String // "contract" | "business_permit" | "id_proof" | "other"
  filePath     String // URL to object storage ΓÇö NOT base64
  fileSize     Int? // bytes
  status       String    @default("pending") // pending|verified|rejected
  uploadedAt   DateTime  @default(now())
  verifiedById String? // SystemAdmin id
  verifiedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ENVIRONMENT (tenant environment monitoring)
// Tracks resource usage per tenant environment
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Environment {
  id            String    @id @default(uuid())
  tenantId      String
  envCode       String // e.g. "prod" | "staging" | "sandbox"
  type          String // "production" | "staging" | "sandbox"
  cpuUsage      Float? // percentage
  ramUsage      Float? // percentage
  storageUsage  Float? // percentage
  uptimePct     Float? // percentage
  isDefault     Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, envCode])
  @@index([tenantId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ORGANIZATION
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Account {
  id               String    @id @default(uuid())
  tenantId         String
  assignedUserId   String?
  name             String
  industry         String?
  size             String? // "1-10" | "11-50" | "51-200" | "200+"
  website          String?
  taxId            String?
  notes            String?   @db.Text
  internalNotes    String?   @db.Text
  tags             String[]
  productInterests String[]
  activeProducts   String[]
  customerType     String    @default("Prospect") // Prospect | Active Customer | Inactive Customer | Former Customer
  customerSince    DateTime?
  address          String?
  city             String?
  province         String?
  country          String?   @default("Philippines")
  isArchived       Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  assignedUser  User?          @relation(fields: [assignedUserId], references: [id])
  leads         Lead[]
  customers     Customer[]
  deals         Deal[]
  activities    Activity[]

  @@index([tenantId, isArchived])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedUserId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// CONTACT
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// LEAD
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Lead {
  id                  String    @id @default(uuid())
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  companyName         String?
  address             String?
  firstName           String
  lastName            String
  phone               String?
  email               String?
  description         String?   @db.Text
  website             String?
  productInterest     String[]
  source              String?
  assignedUserId      String?
  status              String    @default("Inquiry")
  accountId           String?
  createdById         String?
  updatedById         String?
  lastStatusChangedAt DateTime?

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  account      Account? @relation(fields: [accountId], references: [id])
  assignedUser User?    @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  createdBy    User?    @relation("CreatedLeads",  fields: [createdById],  references: [id])
  updatedBy    User?    @relation("UpdatedLeads",  fields: [updatedById],  references: [id])

  leadDeals         LeadDeal[]
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  campaignContacts  CampaignContact[]
  emailDeliveryLogs EmailDeliveryLog[]
  SMSQueue          SMSQueue[]
  invoices          Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@index([tenantId, createdById])
}

// ─────────────────────────────────────────────────────
// CUSTOMER
// ─────────────────────────────────────────────────────
model Customer {
  id              String   @id @default(uuid())
  tenantId        String
  createdAt       DateTime @default(now())
  companyName     String?
  address         String?
  firstName       String
  lastName        String
  phone           String?
  email           String?
  productInterest String[]
  source          String?
  assignedUserId  String?
  status          String   @default("Active")
  accountId       String?

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  account      Account? @relation(fields: [accountId], references: [id])
  assignedUser User?    @relation("AssignedCustomers", fields: [assignedUserId], references: [id])

  customerDeals     CustomerDeal[]
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  campaignContacts  CampaignContact[]
  emailDeliveryLogs EmailDeliveryLog[]
  SMSQueue          SMSQueue[]
  invoices          Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PIPELINE & STAGE
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Pipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  type        String? // e.g. "Sales" | "Service" | "Onboarding"
  templateKey String? // identifies seeded templates for upgrades (e.g. "sales-inquiries")
  isDefault   Boolean  @default(false)
  currency    String?  @default("PHP")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  stages Stage[]
  deals  Deal[]

  @@index([tenantId, isArchived])
}

model Stage {
  id              String   @id @default(uuid())
  pipelineId      String
  tenantId        String // defence-in-depth: derived from Pipeline.tenantId at creation, never independently editable
  name            String
  order           Int
  probability     Int? // 0-100 for revenue forecasting
  color           String? // hex e.g. "#3fb950"
  description     String?
  isWon           Boolean  @default(false) // terminal: deal won
  isLost          Boolean  @default(false) // terminal: deal lost
  isDefault       Boolean  @default(false) // starting stage for new deals
  requiredFields  String[] // Deal fields required before entry (REQ089) e.g. ["accountId", "value"]
  rottenAfterDays Int? // days after which a deal in this stage is flagged stale
  createdAt       DateTime @default(now())

  pipeline               Pipeline           @relation(fields: [pipelineId], references: [id])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  deals                  Deal[]
  dealStageHistoriesNew  DealStageHistory[] @relation("NewStage")
  dealStageHistoriesPrev DealStageHistory[] @relation("PreviousStage")

  @@index([pipelineId, order])
  @@index([tenantId, pipelineId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// DEAL
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Deal {
  id                String    @id @default(uuid())
  tenantId          String
  pipelineId        String
  stageId           String
  leadId            String?
  customerId        String? // legacy singular FK ΓÇö use ContactDeal for new multi-contact deals
  accountId         String?
  assignedUserId    String?
  ownerId           String? // original deal owner (immutable)
  title             String
  value             Float?
  currency          String?   @default("PHP")
  priority          Priority  @default(MEDIUM)
  expectedCloseDate DateTime?
  closedAt          DateTime? // stamped when stage.isWon or stage.isLost = true
  lostReason        String?
  description       String?
  leadSource        String?
  industry          String?
  productInterests  String[]
  address           String?
  tags              String[] // normalized to array ΓÇö consistent with Contact.tags and Organization.tags
  order             Int       @default(0)
  isArchived        Boolean   @default(false)
  archiveReason     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  pipeline       Pipeline           @relation(fields: [pipelineId], references: [id])
  stage          Stage              @relation(fields: [stageId], references: [id])
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer       Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organization   Account?           @relation(fields: [accountId], references: [id])
  assignedUser   User?              @relation("AssignedDeals", fields: [assignedUserId], references: [id])
  owner          User?              @relation("OwnedDeals", fields: [ownerId], references: [id])
  leadDeals      LeadDeal[]
  customerDeals  CustomerDeal[]
  stageHistories DealStageHistory[]
  actions        DealAction[]
  tasks          Task[]
  activities     Activity[]
  invoices       Invoice[]

  @@index([tenantId, stageId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isArchived])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// CONTACT-DEAL JUNCTION (multi-contact deals)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model LeadDeal {
  id        String   @id @default(uuid())
  leadId    String
  dealId    String
  tenantId  String
  role      String?
  addedById String?
  addedAt   DateTime @default(now())

  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id])
  addedBy User?  @relation(fields: [addedById], references: [id])

  @@unique([leadId, dealId])
  @@index([dealId, tenantId])
  @@index([leadId, tenantId])
}

model CustomerDeal {
  id         String   @id @default(uuid())
  customerId String
  dealId     String
  tenantId   String
  role       String?
  addedById  String?
  addedAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal     Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  addedBy  User?    @relation(fields: [addedById], references: [id])

  @@unique([customerId, dealId])
  @@index([dealId, tenantId])
  @@index([customerId, tenantId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// DEAL STAGE HISTORY
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model DealStageHistory {
  id              String   @id @default(uuid())
  tenantId        String
  dealId          String
  previousStageId String?
  newStageId      String
  movedById       String
  movedAt         DateTime @default(now())
  timeInPrevStage Int? // minutes spent in previous stage (computed on insert)
  note            String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  deal          Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  movedBy       User   @relation(fields: [movedById], references: [id])
  newStage      Stage  @relation("NewStage", fields: [newStageId], references: [id])
  previousStage Stage? @relation("PreviousStage", fields: [previousStageId], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, movedAt])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// DEAL ACTION (manual actions performed on a deal)
// Mentor requirement: update_field, assign_agent, change_status, send_email, send_sms, etc.
// Distinct from automated WorkflowExecutionStep ΓÇö these are user-initiated deal operations.
// Every DealAction also triggers an Activity entry for the timeline.
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model DealAction {
  id            String         @id @default(uuid())
  tenantId      String
  dealId        String
  performedById String
  actionType    DealActionType
  payload       Json? // e.g. { field: "status", from: "WARM", to: "HOT" } or { to: "user@email.com" }
  note          String?
  performedAt   DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, actionType])
  @@index([tenantId, performedAt])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TASK
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Task {
  id             String    @id @default(uuid())
  tenantId       String
  dealId         String?
  leadId         String?
  customerId     String?
  accountId      String?
  assignedUserId String
  assignedById   String?
  completedById  String?
  title          String
  description    String?
  status         String    @default("pending") // pending|in_progress|blocked|completed|cancelled
  priority       String    @default("Medium") // Low|Medium|High
  dueDate        DateTime
  reminderAt     DateTime?
  completedAt    DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User       @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  assignedBy   User?      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  completedBy  User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])
  activities   Activity[]

  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, dealId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// ACTIVITY (unified timeline ΓÇö typed FKs, no polymorphic)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  createdById String
  type        String // call|meeting|email|sms|note|task|workflow|stage_change|deal_action|file_upload
  title       String
  description String?
  metadata    Json?
  // Exactly one of these is non-null
  leadId      String?
  customerId  String?
  dealId      String?
  accountId   String?
  taskId      String?
  invoiceId   String?
  createdAt   DateTime @default(now())

  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  createdBy    User      @relation(fields: [createdById], references: [id])
  lead         Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer     Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal         Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  task         Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice      Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, dealId, createdAt])
  @@index([tenantId, createdAt])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// NOTIFICATION
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String // deal_assigned|task_due|campaign_sent|workflow_failed|deal_action|...
  title      String
  body       String?
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, isRead])
  @@index([tenantId, createdAt])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TARGET AUDIENCE (campaign segmentation ΓÇö no audience_contacts table)
// Contacts are resolved at query time using TargetAudienceCondition filters.
// mentor: "no need for audience_contacts, just filtration logic, query from contacts"
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model TargetAudience {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  conditions TargetAudienceCondition[]
  campaigns  Campaign[]

  @@index([tenantId, isActive])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TARGET AUDIENCE CONDITION (filter rules)
// e.g. { field: "status", operator: "equals", value: "HOT" }
// e.g. { field: "score", operator: "gte", value: "80" }
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model TargetAudienceCondition {
  id               String   @id @default(uuid())
  targetAudienceId String
  field            String // contact field name e.g. "status", "score", "source", "tags"
  operator         String // equals|not_equals|contains|gte|lte|in|not_in
  value            String // stored as string, cast at query time
  conditionOrder   Int      @default(0)
  createdAt        DateTime @default(now())

  targetAudience TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Cascade)

  @@index([targetAudienceId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// CAMPAIGN & TEMPLATE
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Campaign {
  id               String         @id @default(uuid())
  tenantId         String
  targetAudienceId String? // FK to TargetAudience ΓÇö replaces old targetAudience String?
  emailTemplateId  String? // optional FK to Template (type=Email)
  smsTemplateId    String? // optional FK to Template (type=SMS)
  name             String
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  subject          String?
  body             String? // inline body override when no template selected
  sentCount        Int            @default(0)
  openedCount      Int            @default(0)
  clickedCount     Int            @default(0)
  engagement       Float          @default(0)
  scheduledFor     DateTime?
  sentAt           DateTime?
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  targetAudience    TargetAudience?    @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  emailTemplate     Template?          @relation("CampaignEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  smsTemplate       Template?          @relation("CampaignSmsTemplate", fields: [smsTemplateId], references: [id], onDelete: SetNull)
  campaignContacts  CampaignContact[]
  metrics           CampaignMetrics[]
  emailDeliveryLogs EmailDeliveryLog[]
  SMSQueue          SMSQueue[]

  @@index([tenantId, status])
  @@index([tenantId, isArchived])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// CAMPAIGN METRICS (historical snapshots ΓÇö separate from inline totals on Campaign)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model CampaignMetrics {
  id             String   @id @default(uuid())
  tenantId       String
  campaignId     String
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  openedCount    Int      @default(0)
  clickedCount   Int      @default(0)
  respondedCount Int      @default(0)
  bouncedCount   Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  deliveryRate   Float    @default(0)
  responseRate   Float    @default(0)
  bounceRate     Float    @default(0)
  snapshotAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, tenantId])
  @@index([tenantId, snapshotAt])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// CAMPAIGN-CONTACT JUNCTION (per-contact delivery tracking)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model CampaignContact {
  id           String    @id @default(uuid())
  tenantId     String
  campaignId   String
  leadId       String?
  customerId   String?
  status       String    @default("pending") // pending|sent|delivered|opened|clicked|bounced|unsubscribed
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  unsubscribed Boolean   @default(false)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@unique([campaignId, customerId])
  @@index([campaignId, tenantId, status])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// TEMPLATE (single model, type = Email | SMS)
// Campaign links to this via emailTemplateId or smsTemplateId
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Template {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  type       String // "Email" | "SMS"
  category   String?
  subject    String? // email only
  content    String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  campaignsAsEmail Campaign[] @relation("CampaignEmailTemplate")
  campaignsAsSms   Campaign[] @relation("CampaignSmsTemplate")

  @@index([tenantId, type, isArchived])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// WORKFLOW & EXECUTION CHAIN
// conditions and actions stored as typed JSON (never eval()'d)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String // e.g. "deal.stage_changed" | "contact.created" | "task.overdue"
  conditions  Json? // WorkflowCondition[] typed JSON
  actions     Json // WorkflowAction[] typed JSON
  isActive    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  triggerRecords WorkflowTriggerRecord[]

  @@index([tenantId, isActive])
}

model WorkflowTriggerRecord {
  id          String   @id @default(uuid())
  tenantId    String
  workflowId  String
  triggerType String
  entityType  String
  entityId    String
  triggeredAt DateTime @default(now())
  payload     Json?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  workflow Workflow               @relation(fields: [workflowId], references: [id])
  runs     WorkflowExecutionRun[]

  @@index([tenantId, workflowId])
  @@index([tenantId, triggeredAt])
}

model WorkflowExecutionRun {
  id           String    @id @default(uuid())
  tenantId     String
  workflowId   String
  triggerId    String
  entityType   String
  entityId     String
  status       String    @default("running") // running|completed|failed|skipped
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id])
  trigger WorkflowTriggerRecord   @relation(fields: [triggerId], references: [id])
  steps   WorkflowExecutionStep[]

  @@index([tenantId, workflowId, status])
  @@index([tenantId, startedAt])
}

model WorkflowExecutionStep {
  id          String   @id @default(uuid())
  tenantId    String
  executionId String
  stepIndex   Int
  actionType  String // create_task|send_email|assign_owner|update_field|send_sms|change_status|...
  status      String // success|failed|skipped
  output      Json?
  error       String?
  executedAt  DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  execution WorkflowExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// INVOICE & PAYMENT TRANSACTION
// Invoice now links to Subscription for billing-driven invoices
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  subscriptionId  String? // link to Subscription for recurring billing invoices
  dealId          String?
  leadId          String?
  customerId      String?
  accountId       String?
  invoiceNumber   String // INV-2024-001 (tenant-scoped auto-generated)
  plan            String?
  amount          Float
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float
  currency        String    @default("PHP")
  frequency       String // Monthly|Quarterly|Annual|One-time
  status          String    @default("Pending")
  paymentStatus   String    @default("Unpaid")
  startDate       DateTime
  dueDate         DateTime?
  nextBillingDate DateTime?
  paidAt          DateTime?
  notes           String?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deal         Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer     Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  activities   Activity[]

  @@index([tenantId, status, paymentStatus])
  @@index([tenantId, dueDate])
  @@index([tenantId, invoiceNumber])
}

model PaymentTransaction {
  id                 String    @id @default(uuid())
  tenantId           String
  invoiceId          String
  paymentMethodId    String? // FK to PaymentMethod (saved method) ΓÇö nullable for ad-hoc
  amount             Float
  currency           String    @default("PHP")
  status             String    // pending|paid|failed|refunded|partially_refunded
  transactionRef     String?   // internal or external reference number
  paymongoPaymentId  String?   @unique
  paymongoPaymentUrl String?
  paymentMethod      String?   // card|gcash|maya|bank_transfer|stripe (denorm for quick display)
  paidAt             DateTime?
  failureReason      String?
  metadata           Json?
  // ── Stripe ────────────────────────────────────────────────────────
  stripePaymentIntentId    String?  @unique  // pi_xxx
  stripeCheckoutSessionId  String?           // cs_xxx — checkout origin
  stripeInvoiceId          String?           // in_xxx — for subscription invoices
  stripeEventId            String?           // evt_xxx — webhook event that created this record (idempotency)
  refundedAmount           Float?            // partial refund tracking
  refundedAt               DateTime?
  stripeRefundId           String?  @unique  // re_xxx
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  invoice     Invoice        @relation(fields: [invoiceId], references: [id])
  savedMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([paymongoPaymentId])
  @@index([stripePaymentIntentId])
  @@index([stripeEventId])
}

// ─────────────────────────────────────────────────────
// AUDIT LOG
// Mentor: "Audit Log is needed, logs of all actions with categorization"
// severity: INFO | WARNING | CRITICAL
// category: auth | crm | billing | workflow | admin | system
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String // e.g. "contact.created" | "deal.stage_changed" | "user.login"
  entityType String // e.g. "Contact" | "Deal" | "User"
  entityId   String?
  category   String   @default("crm") // auth|crm|billing|workflow|admin|system
  changeset  Json? // { before: { status: "WARM" }, after: { status: "HOT" } }
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  severity   String   @default("INFO") // INFO|WARNING|CRITICAL
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, category])
  @@index([tenantId, severity])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// EMAIL DELIVERY LOG
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model EmailDeliveryLog {
  id             String    @id @default(uuid())
  tenantId       String
  campaignId     String?
  leadId         String?
  customerId     String?
  fromEmail      String
  toEmail        String
  subject        String
  gmailMessageId String?   @unique
  gmailThreadId  String?
  status         String // sent|delivered|opened|clicked|bounced|failed
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer   Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  EmailEvent EmailEvent[]

  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([gmailMessageId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// VERIFICATION TOKEN (Email Verification)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// PASSWORD RESET TOKEN
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// REGISTRATION OTP TOKEN (email verification during registration)
model RegistrationOtpToken {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([email])
}
// EMAIL ACCOUNT (Gmail OAuth2 integration per user)
// Stores encrypted tokens for Gmail API access.
// Each user can connect ONE Gmail account per tenant.
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model EmailAccount {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  provider       String    @default("gmail") // "gmail" | future: "outlook"
  email          String // the connected Gmail address
  accessToken    String // encrypted ΓÇö never log or expose
  refreshToken   String? // encrypted ΓÇö needed for offline access
  tokenExpiresAt DateTime?
  scopes         String[] // granted OAuth scopes
  isActive       Boolean   @default(true)
  lastSyncAt     DateTime?
  syncCursor     String? // Gmail history ID for incremental sync
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId, userId])
  @@index([tenantId, isActive])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// SMS QUEUE (Local Android Gateway)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model SMSQueue {
  id           String    @id @default(uuid())
  tenantId     String
  campaignId   String?
  leadId       String?
  customerId   String?
  toNumber     String
  message      String
  status       String    @default("pending") // pending|processing|sent|delivered|failed
  retryCount   Int       @default(0)
  scheduledFor DateTime?
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// EMAIL EVENT (Tracking opens, clicks, etc.)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model EmailEvent {
  id            String   @id @default(uuid())
  tenantId      String
  deliveryLogId String
  eventType     String // open|click|bounce|unsubscribe
  url           String? // for clicks
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  deliveryLog EmailDeliveryLog @relation(fields: [deliveryLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType])
  @@index([deliveryLogId])
}

// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
// AUTOMATION RULE (Trigger-based background jobs)
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
model AutomationRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  triggerType String // e.g. "contact.created", "deal.won", "no.reply.3days"
  conditions  Json?
  actions     Json // what to do (e.g., schedule campaign)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@index([tenantId, triggerType])
}

// ─────────────────────────────────────────────────────
// USER PREFERENCE (per-user, per-module, per-key)
// Generic preference storage for column configs, filters, sorts, etc.
// ─────────────────────────────────────────────────────
model UserPreference {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  module    String   @db.VarChar(64)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, module, key])
  @@index([tenantId, module])
}

// ─────────────────────────────────────────────────────
// TENANT PREFERENCE (per-tenant, per-module, per-key)
// Tenant-level defaults managed by Client Admins.
// ─────────────────────────────────────────────────────
model TenantPreference {
  id        String   @id @default(uuid())
  tenantId  String
  module    String   @db.VarChar(64)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
}
