// LeadCRM — Prisma Schema
// Single source of truth for all database models
// ORM: Prisma 5 | DB: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum TenantStatus {
  SANDBOX
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContactStatus {
  HOT
  WARM
  COLD
  CANCELLED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignType {
  EMAIL
  SMS
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SCHEDULED
}

// Actions that can be manually performed on a deal
enum DealActionType {
  UPDATE_FIELD
  ASSIGN_AGENT
  CHANGE_STATUS
  SEND_EMAIL
  SEND_SMS
  ADD_NOTE
  CREATE_TASK
  CHANGE_STAGE
}

// ─────────────────────────────────────────────
// SYSTEM ADMIN (cross-tenant — LeadCRM operators)
// No tenantId — these users own the platform itself
// ─────────────────────────────────────────────
model SystemAdmin {
  id           String   @id @default(cuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─────────────────────────────────────────────
// PRICING PLAN (global — not tenant-scoped)
// Managed by SystemAdmin, consumed by Subscription
// ─────────────────────────────────────────────
model PricingPlan {
  id             String   @id @default(cuid())
  name           String   @unique  // "Free" | "Pro" | "Enterprise"
  planType       PlanType
  monthlyPrice   Float    @default(0)
  quarterlyPrice Float    @default(0)
  annualPrice    Float    @default(0)
  maxUsers       Int?
  maxContacts    Int?
  maxDeals       Int?
  storageLimit   Int?     // MB
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
}

// ─────────────────────────────────────────────
// PLAN FEATURE
// ─────────────────────────────────────────────
model PlanFeature {
  id          String @id @default(cuid())
  planId      String
  name        String // e.g. "Workflow Automation", "Gmail Integration"
  description String?

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// ─────────────────────────────────────────────
// TENANT
// plan/subscriptionStatus are denormalized caches for fast plan-gating.
// Subscription is the authoritative billing source.
// ─────────────────────────────────────────────
model Tenant {
  id                 String             @id @default(cuid())
  name               String
  slug               String             @unique
  industry           String?
  companySize        String?            // "1-10" | "11-50" | "51-200" | "200+"
  email              String?
  phone              String?
  address            String?
  status             TenantStatus       @default(SANDBOX)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  plan               PlanType           @default(FREE)  // denorm cache — source of truth = Subscription
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  maxUsers           Int?
  maxContacts        Int?
  maxDeals           Int?
  approvedById       String?            // SystemAdmin id who approved
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users              User[]
  userRoles          UserRole[]
  roleDefinitions    RoleDefinition[]
  sessions           Session[]
  invitations        TenantInvitation[]
  subscriptions      Subscription[]
  paymentMethods     PaymentMethod[]
  organizations      Organization[]
  contacts           Contact[]
  pipelines          Pipeline[]
  deals              Deal[]
  dealActions        DealAction[]
  contactDeals       ContactDeal[]
  dealStageHistories DealStageHistory[]
  tasks              Task[]
  activities         Activity[]
  campaigns          Campaign[]
  campaignContacts   CampaignContact[]
  campaignMetrics    CampaignMetrics[]
  templates          Template[]
  targetAudiences    TargetAudience[]
  workflows          Workflow[]
  wfTriggerRecords   WorkflowTriggerRecord[]
  wfExecutionRuns    WorkflowExecutionRun[]
  wfExecutionSteps   WorkflowExecutionStep[]
  invoices           Invoice[]
  paymentTxns        PaymentTransaction[]
  serviceOrders      ServiceOrder[]
  assets             Asset[]
  inventoryItems     InventoryItem[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  emailDeliveryLogs  EmailDeliveryLog[]
  documents          TenantDocument[]
  environments       Environment[]
}

// ─────────────────────────────────────────────
// SUBSCRIPTION (billing source of truth)
// ─────────────────────────────────────────────
model Subscription {
  id              String             @id @default(cuid())
  tenantId        String
  planId          String
  billingCycle    BillingCycle
  status          SubscriptionStatus @default(TRIAL)
  amount          Float
  startDate       DateTime
  endDate         DateTime?
  nextBillingDate DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  plan     PricingPlan @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// PAYMENT METHOD (saved methods per tenant)
// ─────────────────────────────────────────────
model PaymentMethod {
  id            String   @id @default(cuid())
  tenantId      String
  methodName    String   // "GCash" | "Maya" | "Credit Card" | "Bank Transfer"
  accountName   String?
  accountNumber String?  // masked — e.g. "****1234"
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  transactions PaymentTransaction[]

  @@index([tenantId, isActive])
}

// ─────────────────────────────────────────────
// USER
// ─────────────────────────────────────────────
model User {
  id           String     @id @default(cuid())
  tenantId     String
  email        String
  firstName    String
  lastName     String
  passwordHash String
  // role kept as String for JWT compatibility during UserRole migration.
  // New code should read role from UserRole junction; this is the legacy fallback.
  role         String     @default("Sales Rep")
  status       UserStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  tenant               Tenant             @relation(fields: [tenantId], references: [id])
  userRoles            UserRole[]
  sessions             Session[]
  invitationsSent      TenantInvitation[] @relation("InvitedByUser")
  organizationsOwned   Organization[]
  assignedContacts     Contact[]          @relation("AssignedContacts")
  ownedContacts        Contact[]          @relation("OwnedContacts")
  assignedDeals        Deal[]             @relation("AssignedDeals")
  ownedDeals           Deal[]             @relation("OwnedDeals")
  contactDealsAdded    ContactDeal[]
  dealStageHistories   DealStageHistory[]
  dealActionsPerformed DealAction[]
  assignedTasks        Task[]             @relation("AssignedTasks")
  tasksAssignedByMe    Task[]             @relation("TaskAssignedBy")
  completedTasks       Task[]             @relation("TaskCompletedBy")
  activitiesCreated    Activity[]
  serviceOrders        ServiceOrder[]
  notifications        Notification[]
  auditLogs            AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// ROLE DEFINITION
// permissions String[] removed — use RolePermission table instead
// ─────────────────────────────────────────────
model RoleDefinition {
  id           String    @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  isSystemRole Boolean   @default(false)
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  invitations TenantInvitation[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId, isArchived])
}

// ─────────────────────────────────────────────
// ROLE PERMISSION (per-module CRUD flags)
// One row per module per role.
// module examples: contacts | deals | campaigns | workflows | billing | reports | users | settings
// ─────────────────────────────────────────────
model RolePermission {
  id        String @id @default(cuid())
  tenantId  String
  roleId    String
  module    String // e.g. "contacts", "deals", "campaigns"
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
  @@index([tenantId, module])
}

// ─────────────────────────────────────────────
// USER ROLE (JUNCTION)
// ─────────────────────────────────────────────
model UserRole {
  id       String @id @default(cuid())
  userId   String
  roleId   String
  tenantId String

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId, tenantId])
  @@index([userId, tenantId])
}

// ─────────────────────────────────────────────
// SESSION (Token Revocation)
// ─────────────────────────────────────────────
model Session {
  id           String    @id @default(cuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique  // SHA-256 of JWT, never plaintext
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
  @@index([tokenHash])
}

// ─────────────────────────────────────────────
// TENANT INVITATION
// ─────────────────────────────────────────────
model TenantInvitation {
  id          String    @id @default(cuid())
  tenantId    String
  email       String
  roleId      String
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  invitedBy User           @relation("InvitedByUser", fields: [invitedById], references: [id])
  role      RoleDefinition @relation(fields: [roleId], references: [id])

  @@index([token])
  @@index([email, tenantId])
}

// ─────────────────────────────────────────────
// TENANT DOCUMENT (onboarding files, contracts, etc.)
// ─────────────────────────────────────────────
model TenantDocument {
  id           String    @id @default(cuid())
  tenantId     String
  fileName     String
  documentType String    // "contract" | "business_permit" | "id_proof" | "other"
  filePath     String    // URL to object storage — NOT base64
  fileSize     Int?      // bytes
  status       String    @default("pending") // pending|verified|rejected
  uploadedAt   DateTime  @default(now())
  verifiedById String?   // SystemAdmin id
  verifiedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

// ─────────────────────────────────────────────
// ENVIRONMENT (tenant environment monitoring)
// Tracks resource usage per tenant environment
// ─────────────────────────────────────────────
model Environment {
  id            String   @id @default(cuid())
  tenantId      String
  envCode       String   // e.g. "prod" | "staging" | "sandbox"
  type          String   // "production" | "staging" | "sandbox"
  cpuUsage      Float?   // percentage
  ramUsage      Float?   // percentage
  storageUsage  Float?   // percentage
  uptimePct     Float?   // percentage
  isDefault     Boolean  @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, envCode])
  @@index([tenantId])
}

// ─────────────────────────────────────────────
// ORGANIZATION
// ─────────────────────────────────────────────
model Organization {
  id             String    @id @default(cuid())
  tenantId       String
  assignedUserId String?
  name           String
  industry       String?
  size           String?   // "1-10" | "11-50" | "51-200" | "200+"
  website        String?
  taxId          String?
  notes          String?   @db.Text
  internalNotes  String?   @db.Text
  tags           String[]
  productInterests String[]
  activeProducts String[]
  customerType   String    @default("Prospect") // Prospect | Active Customer | Inactive Customer | Former Customer
  customerSince  DateTime?
  address        String?
  city           String?
  province       String?
  country        String?   @default("Philippines")
  isArchived     Boolean   @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  assignedUser  User?          @relation(fields: [assignedUserId], references: [id])
  contacts      Contact[]
  deals         Deal[]
  activities    Activity[]
  serviceOrders ServiceOrder[]
  assets        Asset[]

  @@index([tenantId, isArchived])
  @@index([tenantId, name])
}

// ─────────────────────────────────────────────
// CONTACT
// ─────────────────────────────────────────────
model Contact {
  id              String        @id @default(cuid())
  tenantId        String
  organizationId  String?
  assignedUserId  String?
  ownerId         String?       // original capturer (immutable — set on create, never updated)
  firstName       String
  lastName        String
  email           String?
  phone           String?
  company         String?
  jobTitle        String?
  linkedinUrl     String?
  status          ContactStatus @default(WARM)
  score           Int           @default(75)
  source          String?
  notes           String?
  productInterests String[]
  activeProducts  String[]
  customerType    String        @default("Prospect") // Prospect | Active Customer | Inactive Customer | Former Customer
  customerSince   DateTime?
  address         String?
  lastContactedAt DateTime?
  convertedAt     DateTime?
  doNotContact    Boolean       @default(false)
  isArchived      Boolean       @default(false)
  archiveReason   String?
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant            Tenant            @relation(fields: [tenantId], references: [id])
  organization      Organization?     @relation(fields: [organizationId], references: [id])
  assignedUser      User?             @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  owner             User?             @relation("OwnedContacts", fields: [ownerId], references: [id])
  contactDeals      ContactDeal[]
  tasks             Task[]
  activities        Activity[]
  invoices          Invoice[]
  serviceOrders     ServiceOrder[]
  campaignContacts  CampaignContact[]
  emailDeliveryLogs EmailDeliveryLog[]

  // legacy singular FK kept for backward compatibility during ContactDeal migration
  deals Deal[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isArchived])
  @@index([tenantId, email])
}

// ─────────────────────────────────────────────
// PIPELINE & STAGE
// ─────────────────────────────────────────────
model Pipeline {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  type       String?  // e.g. "Sales" | "Service" | "Onboarding"
  isDefault  Boolean  @default(false)
  currency   String?  @default("PHP")
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  stages Stage[]
  deals  Deal[]

  @@index([tenantId, isArchived])
}

model Stage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  probability Int?     // 0-100 for revenue forecasting
  color       String?  // hex e.g. "#3fb950"
  description String?
  isWon       Boolean  @default(false) // terminal: deal won
  isLost      Boolean  @default(false) // terminal: deal lost
  isDefault   Boolean  @default(false) // starting stage for new deals
  createdAt   DateTime @default(now())

  pipeline               Pipeline           @relation(fields: [pipelineId], references: [id])
  deals                  Deal[]
  dealStageHistoriesNew  DealStageHistory[] @relation("NewStage")
  dealStageHistoriesPrev DealStageHistory[] @relation("PreviousStage")

  @@index([pipelineId, order])
}

// ─────────────────────────────────────────────
// DEAL
// ─────────────────────────────────────────────
model Deal {
  id                String    @id @default(cuid())
  tenantId          String
  pipelineId        String
  stageId           String
  contactId         String?   // legacy singular FK — use ContactDeal for new multi-contact deals
  organizationId    String?
  assignedUserId    String?
  ownerId           String?   // original deal owner (immutable)
  title             String
  value             Float?
  currency          String?   @default("PHP")
  priority          Priority  @default(MEDIUM)
  expectedCloseDate DateTime?
  closedAt          DateTime? // stamped when stage.isWon or stage.isLost = true
  lostReason        String?
  description       String?
  leadSource        String?
  industry          String?
  productInterests  String[]
  address           String?
  tags              String?
  order             Int       @default(0)
  isArchived        Boolean   @default(false)
  archiveReason     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  pipeline       Pipeline         @relation(fields: [pipelineId], references: [id])
  stage          Stage            @relation(fields: [stageId], references: [id])
  contact        Contact?         @relation(fields: [contactId], references: [id])
  organization   Organization?    @relation(fields: [organizationId], references: [id])
  assignedUser   User?            @relation("AssignedDeals", fields: [assignedUserId], references: [id])
  owner          User?            @relation("OwnedDeals", fields: [ownerId], references: [id])
  contactDeals   ContactDeal[]
  stageHistories DealStageHistory[]
  actions        DealAction[]
  tasks          Task[]
  activities     Activity[]
  invoices       Invoice[]
  serviceOrders  ServiceOrder[]

  @@index([tenantId, stageId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isArchived])
}

// ─────────────────────────────────────────────
// CONTACT-DEAL JUNCTION (multi-contact deals)
// ─────────────────────────────────────────────
model ContactDeal {
  id        String   @id @default(cuid())
  contactId String
  dealId    String
  tenantId  String
  role      String?  // "Primary Contact" | "Decision Maker" | "Technical Evaluator"
  addedById String?
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  addedBy User?   @relation(fields: [addedById], references: [id])

  @@unique([contactId, dealId])
  @@index([dealId, tenantId])
  @@index([contactId, tenantId])
}

// ─────────────────────────────────────────────
// DEAL STAGE HISTORY
// ─────────────────────────────────────────────
model DealStageHistory {
  id              String    @id @default(cuid())
  tenantId        String
  dealId          String
  previousStageId String?
  newStageId      String
  movedById       String
  movedAt         DateTime  @default(now())
  timeInPrevStage Int?      // minutes spent in previous stage (computed on insert)
  note            String?

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  deal          Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  movedBy       User    @relation(fields: [movedById], references: [id])
  newStage      Stage   @relation("NewStage", fields: [newStageId], references: [id])
  previousStage Stage?  @relation("PreviousStage", fields: [previousStageId], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, movedAt])
}

// ─────────────────────────────────────────────
// DEAL ACTION (manual actions performed on a deal)
// Mentor requirement: update_field, assign_agent, change_status, send_email, send_sms, etc.
// Distinct from automated WorkflowExecutionStep — these are user-initiated deal operations.
// Every DealAction also triggers an Activity entry for the timeline.
// ─────────────────────────────────────────────
model DealAction {
  id            String         @id @default(cuid())
  tenantId      String
  dealId        String
  performedById String
  actionType    DealActionType
  payload       Json?          // e.g. { field: "status", from: "WARM", to: "HOT" } or { to: "user@email.com" }
  note          String?
  performedAt   DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, actionType])
  @@index([tenantId, performedAt])
}

// ─────────────────────────────────────────────
// TASK
// ─────────────────────────────────────────────
model Task {
  id             String    @id @default(cuid())
  tenantId       String
  dealId         String?
  contactId      String?
  organizationId String?
  assignedUserId String
  assignedById   String?
  completedById  String?
  title          String
  description    String?
  status         String    @default("pending") // pending|in_progress|blocked|completed|cancelled
  priority       String    @default("Medium")  // Low|Medium|High
  dueDate        DateTime
  reminderAt     DateTime?
  completedAt    DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser User          @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  assignedBy   User?         @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  completedBy  User?         @relation("TaskCompletedBy", fields: [completedById], references: [id])
  activities   Activity[]

  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, dealId])
}

// ─────────────────────────────────────────────
// ACTIVITY (unified timeline — typed FKs, no polymorphic)
// ─────────────────────────────────────────────
model Activity {
  id             String    @id @default(cuid())
  tenantId       String
  createdById    String
  type           String    // call|meeting|email|sms|note|task|workflow|stage_change|deal_action|file_upload
  title          String
  description    String?
  metadata       Json?
  // Exactly one of these is non-null
  contactId      String?
  dealId         String?
  organizationId String?
  taskId         String?
  invoiceId      String?
  createdAt      DateTime  @default(now())

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, dealId, createdAt])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────
// NOTIFICATION
// ─────────────────────────────────────────────
model Notification {
  id         String    @id @default(cuid())
  tenantId   String
  userId     String
  type       String    // deal_assigned|task_due|campaign_sent|workflow_failed|deal_action|...
  title      String
  body       String?
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, isRead])
  @@index([tenantId, createdAt])
}

// ─────────────────────────────────────────────
// TARGET AUDIENCE (campaign segmentation — no audience_contacts table)
// Contacts are resolved at query time using TargetAudienceCondition filters.
// mentor: "no need for audience_contacts, just filtration logic, query from contacts"
// ─────────────────────────────────────────────
model TargetAudience {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant                   @relation(fields: [tenantId], references: [id])
  conditions TargetAudienceCondition[]
  campaigns  Campaign[]

  @@index([tenantId, isActive])
}

// ─────────────────────────────────────────────
// TARGET AUDIENCE CONDITION (filter rules)
// e.g. { field: "status", operator: "equals", value: "HOT" }
// e.g. { field: "score", operator: "gte", value: "80" }
// ─────────────────────────────────────────────
model TargetAudienceCondition {
  id               String @id @default(cuid())
  targetAudienceId String
  field            String   // contact field name e.g. "status", "score", "source", "tags"
  operator         String   // equals|not_equals|contains|gte|lte|in|not_in
  value            String   // stored as string, cast at query time
  conditionOrder   Int      @default(0)
  createdAt        DateTime @default(now())

  targetAudience TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Cascade)

  @@index([targetAudienceId])
}

// ─────────────────────────────────────────────
// CAMPAIGN & TEMPLATE
// ─────────────────────────────────────────────
model Campaign {
  id               String         @id @default(cuid())
  tenantId         String
  targetAudienceId String?        // FK to TargetAudience — replaces old targetAudience String?
  emailTemplateId  String?        // optional FK to Template (type=Email)
  smsTemplateId    String?        // optional FK to Template (type=SMS)
  name             String
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  subject          String?
  body             String?        // inline body override when no template selected
  sentCount        Int            @default(0)
  openedCount      Int            @default(0)
  clickedCount     Int            @default(0)
  engagement       Float          @default(0)
  scheduledFor     DateTime?
  sentAt           DateTime?
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant           Tenant           @relation(fields: [tenantId], references: [id])
  targetAudience   TargetAudience?  @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  emailTemplate    Template?        @relation("CampaignEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  smsTemplate      Template?        @relation("CampaignSmsTemplate", fields: [smsTemplateId], references: [id], onDelete: SetNull)
  campaignContacts CampaignContact[]
  metrics          CampaignMetrics[]
  emailDeliveryLogs EmailDeliveryLog[]

  @@index([tenantId, status])
  @@index([tenantId, isArchived])
}

// ─────────────────────────────────────────────
// CAMPAIGN METRICS (historical snapshots — separate from inline totals on Campaign)
// ─────────────────────────────────────────────
model CampaignMetrics {
  id             String   @id @default(cuid())
  tenantId       String
  campaignId     String
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  openedCount    Int      @default(0)
  clickedCount   Int      @default(0)
  respondedCount Int      @default(0)
  bouncedCount   Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  deliveryRate   Float    @default(0)
  responseRate   Float    @default(0)
  bounceRate     Float    @default(0)
  snapshotAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, tenantId])
  @@index([tenantId, snapshotAt])
}

// ─────────────────────────────────────────────
// CAMPAIGN-CONTACT JUNCTION (per-contact delivery tracking)
// ─────────────────────────────────────────────
model CampaignContact {
  id           String    @id @default(cuid())
  tenantId     String
  campaignId   String
  contactId    String
  status       String    @default("pending") // pending|sent|delivered|opened|clicked|bounced|unsubscribed
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  unsubscribed Boolean   @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact  Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, tenantId, status])
}

// ─────────────────────────────────────────────
// TEMPLATE (single model, type = Email | SMS)
// Campaign links to this via emailTemplateId or smsTemplateId
// ─────────────────────────────────────────────
model Template {
  id         String   @id @default(cuid())
  tenantId   String
  name       String
  type       String   // "Email" | "SMS"
  category   String?
  subject    String?  // email only
  content    String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant            Tenant     @relation(fields: [tenantId], references: [id])
  campaignsAsEmail  Campaign[] @relation("CampaignEmailTemplate")
  campaignsAsSms    Campaign[] @relation("CampaignSmsTemplate")

  @@index([tenantId, type, isArchived])
}

// ─────────────────────────────────────────────
// WORKFLOW & EXECUTION CHAIN
// conditions and actions stored as typed JSON (never eval()'d)
// ─────────────────────────────────────────────
model Workflow {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  trigger     String   // e.g. "deal.stage_changed" | "contact.created" | "task.overdue"
  conditions  Json?    // WorkflowCondition[] typed JSON
  actions     Json     // WorkflowAction[] typed JSON
  isActive    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  triggerRecords WorkflowTriggerRecord[]

  @@index([tenantId, isActive])
}

model WorkflowTriggerRecord {
  id          String   @id @default(cuid())
  tenantId    String
  workflowId  String
  triggerType String
  entityType  String
  entityId    String
  triggeredAt DateTime @default(now())
  payload     Json?

  tenant   Tenant               @relation(fields: [tenantId], references: [id])
  workflow Workflow             @relation(fields: [workflowId], references: [id])
  runs     WorkflowExecutionRun[]

  @@index([tenantId, workflowId])
  @@index([tenantId, triggeredAt])
}

model WorkflowExecutionRun {
  id           String    @id @default(cuid())
  tenantId     String
  workflowId   String
  triggerId    String
  entityType   String
  entityId     String
  status       String    @default("running") // running|completed|failed|skipped
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id])
  trigger WorkflowTriggerRecord   @relation(fields: [triggerId], references: [id])
  steps   WorkflowExecutionStep[]

  @@index([tenantId, workflowId, status])
  @@index([tenantId, startedAt])
}

model WorkflowExecutionStep {
  id          String   @id @default(cuid())
  tenantId    String
  executionId String
  stepIndex   Int
  actionType  String   // create_task|send_email|assign_owner|update_field|send_sms|change_status|...
  status      String   // success|failed|skipped
  output      Json?
  error       String?
  executedAt  DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  execution WorkflowExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

// ─────────────────────────────────────────────
// INVOICE & PAYMENT TRANSACTION
// Invoice now links to Subscription for billing-driven invoices
// ─────────────────────────────────────────────
model Invoice {
  id              String    @id @default(cuid())
  tenantId        String
  subscriptionId  String?   // link to Subscription for recurring billing invoices
  dealId          String?
  contactId       String?
  organizationId  String?
  invoiceNumber   String    // INV-2024-001 (tenant-scoped auto-generated)
  plan            String?
  amount          Float
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float
  currency        String    @default("PHP")
  frequency       String    // Monthly|Quarterly|Annual|One-time
  status          String    @default("Pending")
  paymentStatus   String    @default("Unpaid")
  startDate       DateTime
  dueDate         DateTime?
  nextBillingDate DateTime?
  paidAt          DateTime?
  notes           String?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deal         Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact      Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  activities   Activity[]

  @@index([tenantId, status, paymentStatus])
  @@index([tenantId, dueDate])
  @@index([tenantId, invoiceNumber])
}

model PaymentTransaction {
  id                 String    @id @default(cuid())
  tenantId           String
  invoiceId          String
  paymentMethodId    String?   // FK to PaymentMethod (saved method) — nullable for ad-hoc
  amount             Float
  currency           String    @default("PHP")
  status             String    // pending|paid|failed|refunded
  transactionRef     String?   // internal or external reference number
  paymongoPaymentId  String?   @unique
  paymongoPaymentUrl String?
  paymentMethod      String?   // card|gcash|maya|bank_transfer (denorm for quick display)
  paidAt             DateTime?
  failureReason      String?
  metadata           Json?
  createdAt          DateTime  @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  invoice       Invoice        @relation(fields: [invoiceId], references: [id])
  savedMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([paymongoPaymentId])
}

// ─────────────────────────────────────────────
// SERVICE ORDER
// ─────────────────────────────────────────────
model ServiceOrder {
  id                   String    @id @default(cuid())
  tenantId             String
  assignedTechnicianId String?
  contactId            String?
  organizationId       String?
  dealId               String?
  invoiceId            String?
  title                String
  description          String?
  status               String    @default("pending") // pending|in_progress|completed|cancelled
  scheduledDate        DateTime
  completedAt          DateTime?
  actualDurationMins   Int?
  photos               Json?     // { before: [url], after: [url] } — object storage URLs, NOT base64
  signature            String?   // URL to signed document in object storage
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  technician   User?         @relation(fields: [assignedTechnicianId], references: [id])
  contact      Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  deal         Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId, status, assignedTechnicianId])
  @@index([tenantId, scheduledDate])
}

// ─────────────────────────────────────────────
// ASSET & INVENTORY
// ─────────────────────────────────────────────
model Asset {
  id             String    @id @default(cuid())
  tenantId       String
  organizationId String?
  name           String
  category       String    // Security|Telecom|IT|Infrastructure
  serialNumber   String
  client         String
  status         String    @default("Active") // Active|Maintenance|Retired|Faulty
  installDate    DateTime
  warrantyExpiry DateTime
  location       String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, organizationId])
}

model InventoryItem {
  id            String    @id @default(cuid())
  tenantId      String
  name          String
  sku           String
  category      String
  quantity      Int
  minQuantity   Int
  unitPrice     Float
  supplier      String?
  lastRestocked DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sku])
  @@index([tenantId, category])
}

// ─────────────────────────────────────────────
// AUDIT LOG
// Mentor: "Audit Log is needed, logs of all actions with categorization"
// severity: INFO | WARNING | CRITICAL
// category: auth | crm | billing | workflow | admin | system
// ─────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String
  action     String   // e.g. "contact.created" | "deal.stage_changed" | "user.login"
  entityType String   // e.g. "Contact" | "Deal" | "User"
  entityId   String?
  category   String   @default("crm") // auth|crm|billing|workflow|admin|system
  changeset  Json?    // { before: { status: "WARM" }, after: { status: "HOT" } }
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  severity   String   @default("INFO") // INFO|WARNING|CRITICAL
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, category])
  @@index([tenantId, severity])
}

// ─────────────────────────────────────────────
// EMAIL DELIVERY LOG
// ─────────────────────────────────────────────
model EmailDeliveryLog {
  id             String    @id @default(cuid())
  tenantId       String
  campaignId     String?
  contactId      String?
  fromEmail      String
  toEmail        String
  subject        String
  gmailMessageId String?   @unique
  gmailThreadId  String?
  status         String    // sent|delivered|opened|clicked|bounced|failed
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@index([tenantId, contactId])
  @@index([tenantId, campaignId])
  @@index([gmailMessageId])
}

// ─────────────────────────────────────────────
// VERIFICATION TOKEN (Email Verification)
// ─────────────────────────────────────────────
model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────
// PASSWORD RESET TOKEN
// ─────────────────────────────────────────────
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}
