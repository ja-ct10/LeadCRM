# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leadcrm_dev"

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-minimum-32-chars"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed CORS origins
# In production: "https://app.yourdomain.com,https://admin.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# System Admin Seed (run once on first deploy)
# ─────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL="admin@leadcrm.io"
SYSTEM_ADMIN_PASSWORD="change-this-immediately"

# ─────────────────────────────────────────────
# Email / Resend (for password reset emails)
# Get your API key at: https://resend.com
# ─────────────────────────────────────────────
RESEND_API_KEY="re_your_api_key_here"
# Free plan: use onboarding@resend.dev as sender
# With verified domain: LeadCRM <noreply@yourdomain.com>
RESEND_FROM="LeadCRM <onboarding@resend.dev>"

# Password reset token TTL in minutes (default: 60)
PASSWORD_RESET_TTL_MINUTES="60"

# ─────────────────────────────────────────────
# Dev OTP Bypass (development only — never set in production)
# When DEV_OTP_BYPASS=true, seed accounts listed in DEV_SEED_EMAILS
# always use the fixed OTP code "000000" instead of receiving an email.
# ─────────────────────────────────────────────
DEV_OTP_BYPASS="true"
DEV_SEED_EMAILS="admin@democorp.com,bob@democorp.com,super@leadcrm.com,guest@democorp.com"

# ─────────────────────────────────────────────
# Gmail Integration
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="http://localhost:4000/api/v1/marketing/gmail/callback"
UNSUBSCRIBE_URL="http://localhost:3000/unsubscribe"

# ─────────────────────────────────────────────
# SMS Gateway (Android phone on local network)
# ─────────────────────────────────────────────
SMS_GATEWAY_URL="http://192.168.1.100:8080/send"
SMS_DELAY_MS="1500"
SMS_MAX_RETRIES="3"

# ─────────────────────────────────────────────
# PayMongo
# ─────────────────────────────────────────────
PAYMONGO_SECRET_KEY="your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="your-paymongo-public-key"
PAYMONGO_WEBHOOK_SECRET="your-paymongo-webhook-secret"
