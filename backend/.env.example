# Backend runtime. Use development resources locally; never copy production
# credentials here. Hosting builds and starts from the repository root.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://leadcrm:replace-me@localhost:5432/leadcrm_dev
DIRECT_URL=postgresql://leadcrm:replace-me@localhost:5432/leadcrm_dev
JWT_SECRET=replace-with-a-local-only-random-secret
APP_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
# Production: verified ingress IPs/CIDRs only; never true, *, or 0.0.0.0/0.
TRUSTED_PROXIES=loopback
RATE_LIMIT_MAX=500

# Production requires a valid Brevo API key and verified sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=LeadCRM
PASSWORD_RESET_TTL_MINUTES=60
BREVO_DAILY_EMAIL_LIMIT=300
# Required when receiving Brevo campaign delivery webhooks.
BREVO_WEBHOOK_TOKEN=
# Optional development-only email recipient allowlist; ignored in production.
BREVO_SANDBOX_EMAILS=

# Gmail feature configuration. Preserve the production encryption key when
# moving hosts: it protects persisted OAuth tokens. Never rotate during cutover.
ENCRYPTION_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/api/v1/integrations/gmail/callback
# Optional mailbox override; preserve a deliberate production policy only.
GMAIL_TEST_MAILBOX_OVERRIDE=
# Existing connected system-sender account; access/refresh tokens live in the DB.
GMAIL_SYSTEM_SENDER_USER_ID=
GMAIL_SYSTEM_SENDER_GMAIL_EMAIL=
# Optional Gmail display sender fallback, not an SMTP transport credential.
SMTP_FROM=

# SMS feature only. Leave Device ID empty to use TextBee's default device.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
# Required for signed delivery webhooks; inbound SMS remains disabled.
TEXTBEE_WEBHOOK_SECRET=

# Feature required for avatar and CRM file storage; reuse existing buckets.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AVATAR_BUCKET=
SUPABASE_RECORD_FILES_BUCKET=

# Explicit account policy. Production flags must preserve the approved Render
# policy, not broaden access. Development flags never enable production access.
LEADCRM_TEST_AUTH_ENABLED=false
LEADCRM_TEST_EMAIL_ALLOWLIST=
LEADCRM_PRODUCTION_AUTH_ENABLED=false
LEADCRM_PRODUCTION_EMAIL_ALLOWLIST=

# Provider-injected release metadata; leave unset locally.
# SOURCE_COMMIT= (Coolify)
# RENDER_GIT_COMMIT= (Render)
# SKIP_DEMO_TENANTS is a retained deployment convention, not a runtime consumer.
# No seed command runs at startup; never configure DEMO_USER_PASSWORD in hosting.
