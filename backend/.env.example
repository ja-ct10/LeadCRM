# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leadcrm_dev"

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-minimum-32-chars"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed CORS origins
# In production: "https://app.yourdomain.com,https://admin.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# System Admin Seed (run once on first deploy)
# ─────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL="admin@leadcrm.io"
SYSTEM_ADMIN_PASSWORD="change-this-immediately"

# ─────────────────────────────────────────────
# Email / Resend (for password reset emails)
# Get your API key at: https://resend.com
# ─────────────────────────────────────────────
RESEND_API_KEY="re_your_api_key_here"
# Free plan: use onboarding@resend.dev as sender
# With verified domain: LeadCRM <noreply@yourdomain.com>
RESEND_FROM="LeadCRM <onboarding@resend.dev>"
# Comma-separated list of verified emails for Resend sandbox mode
# In production, remove this or leave empty to allow any email
RESEND_SANDBOX_EMAILS="your-verified-email@example.com"

# Password reset token TTL in minutes (default: 60)
PASSWORD_RESET_TTL_MINUTES="60"

# ─────────────────────────────────────────────
# Dev OTP Bypass (development only — never set in production)
# When DEV_OTP_BYPASS=true, seed accounts listed in DEV_SEED_EMAILS
# always use the fixed OTP code "000000" instead of receiving an email.
# ─────────────────────────────────────────────
DEV_OTP_BYPASS="true"
DEV_SEED_EMAILS="admin@gmail.com,super@leadcrm.com,admin@democorp.com,bob@democorp.com,guest@democorp.com"

# ─────────────────────────────────────────────
# Demo / Capstone Mode (safe for staging deployments with NODE_ENV=production)
# When DEMO_MODE=true, seed accounts in DEV_SEED_EMAILS accept OTP "000000".
# Use this on Render/staging instead of changing NODE_ENV.
# NEVER set this on a real customer-facing production server.
# ─────────────────────────────────────────────
# DEMO_MODE="true"

# ─────────────────────────────────────────────
# Seed Control
# Set SKIP_DEMO_TENANTS=true on Render to skip the faker 10-tenant generator.
# The demo accounts (seedDemoAccounts) always run regardless of this flag.
# ─────────────────────────────────────────────
# SKIP_DEMO_TENANTS="true"

# ─────────────────────────────────────────────
# Google OAuth (Sign-In with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

# ─────────────────────────────────────────────
# Gmail Integration
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="http://localhost:4000/api/v1/marketing/gmail/callback"
UNSUBSCRIBE_URL="http://localhost:3000/unsubscribe"

# ─────────────────────────────────────────────
# SMS Gateway (Android phone on local network)
# ─────────────────────────────────────────────
SMS_GATEWAY_URL="http://192.168.1.100:8080/send"
SMS_DELAY_MS="1500"
SMS_MAX_RETRIES="3"

# ─────────────────────────────────────────────
# PayMongo
# ─────────────────────────────────────────────
PAYMONGO_SECRET_KEY="your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="your-paymongo-public-key"
PAYMONGO_WEBHOOK_SECRET="your-paymongo-webhook-secret"

# ─────────────────────────────────────────────
# Stripe (System Admin payment processing)
# Dashboard: https://dashboard.stripe.com/apikeys
#
# Development: use test-mode keys (sk_test_... / pk_test_...)
# Production:  use live-mode keys  (sk_live_... / pk_live_...)
#
# Webhook secret: Dashboard → Developers → Webhooks → your endpoint → Signing secret
# For local dev with Stripe CLI: stripe listen --forward-to localhost:4000/api/v1/webhooks/stripe
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_your_stripe_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_signing_secret"
