# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leadcrm_dev"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/leadcrm_dev"

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-minimum-32-chars"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed CORS origins
# In production: "https://app.yourdomain.com,https://admin.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"
# Backend base URL for server integrations. Verification mail uses APP_URL above.
# Local: http://localhost:4000 | Production: https://your-backend.onrender.com
BACKEND_URL="http://localhost:4000"

# ─────────────────────────────────────────────
# System Admin Seed (run once on first deploy)
# ─────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL="admin@leadcrm.io"
SYSTEM_ADMIN_PASSWORD="change-this-immediately"

# ─────────────────────────────────────────────
# Email (Brevo HTTP API)
# Sole production transport — uses HTTPS :443, no SMTP ports required.
# Works on Render Free tier. Get your API key at: https://app.brevo.com/settings/keys/api
# ─────────────────────────────────────────────
BREVO_API_KEY="xkeysib-your-api-key-here"
# Must be a verified sender in your Brevo account (Senders & IPs -> Senders)
BREVO_FROM_EMAIL="your-verified-sender@gmail.com"
BREVO_FROM_NAME="LeadCRM"

# Sandbox allowlist — development and staging only.
# When set, only listed addresses receive real emails in non-production.
# DO NOT set this variable on Render or any production environment.
BREVO_SANDBOX_EMAILS="your-test-email@example.com"

# Password reset token TTL in minutes (default: 60)
PASSWORD_RESET_TTL_MINUTES="60"

# Email verification magic link TTL in hours (default: 24)
EMAIL_VERIFICATION_TOKEN_TTL_HOURS="24"

# Team invitation token TTL in days (default: 7)
INVITATION_TOKEN_TTL_DAYS="7"

# ─────────────────────────────────────────────
# Dev OTP Bypass (development only — never set in production)
# Optional compatibility bypass for already ACTIVE demo accounts in development.
# It never verifies a pending signup or supplies a fixed registration OTP.
DEV_OTP_BYPASS="false"
DEV_SEED_EMAILS="admin@gmail.com,super@leadcrm.com,admin@camxian.com,bob@camxian.com"

# ─────────────────────────────────────────────
# Demo compatibility mode (development only; blocked in production)
# ─────────────────────────────────────────────
# DEMO_MODE="false"

# ─────────────────────────────────────────────
# Seed Control
# Set SKIP_DEMO_TENANTS=true on Render to skip the faker 10-tenant generator.
# The demo accounts (seedDemoAccounts) always run regardless of this flag.
# ─────────────────────────────────────────────
# SKIP_DEMO_TENANTS="true"

# ─────────────────────────────────────────────
# Google OAuth (Sign-In with Google)
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_ID remains a supported legacy alias.
GOOGLE_OAUTH_CLIENT_SECRET="your-google-oauth-client-secret"

# ─────────────────────────────────────────────
# Gmail Integration
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="http://localhost:4000/api/v1/marketing/gmail/callback"
UNSUBSCRIBE_URL="http://localhost:3000/unsubscribe"

# Gmail System Sender (for sending auth/OTP emails via Gmail API)
# Set to the userId of the EmailAccount record connected for the platform sender
# Run: npm --prefix backend run gmail:setup-system-sender
GMAIL_SYSTEM_SENDER_USER_ID=""
GMAIL_SYSTEM_SENDER_TENANT_ID="system"

# One-time setup — run once to seed the system Gmail sender account:
#   npm --prefix backend run gmail:setup-system-sender
# Then remove these 4 vars and keep only GMAIL_SYSTEM_SENDER_USER_ID=system
GMAIL_SYSTEM_SENDER_GMAIL_EMAIL=""
GMAIL_SYSTEM_SENDER_ACCESS_TOKEN=""
GMAIL_SYSTEM_SENDER_REFRESH_TOKEN=""
GMAIL_SYSTEM_SENDER_EXPIRES_IN=""    # copy "expires_in" from OAuth Playground (e.g. 3599)

# ─────────────────────────────────────────────
# SMS Gateway (Android phone on local network)
# ─────────────────────────────────────────────
SMS_GATEWAY_URL="http://192.168.1.100:8080/send"
SMS_DELAY_MS="1500"
SMS_MAX_RETRIES="3"

# ─────────────────────────────────────────────
# PayMongo
# ─────────────────────────────────────────────
PAYMONGO_SECRET_KEY="your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="your-paymongo-public-key"
PAYMONGO_WEBHOOK_SECRET="your-paymongo-webhook-secret"

# Customer invoice payments use the PayMongo configuration above.
