# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/leadcrm_dev"

# ─────────────────────────────────────────────
# Authentication
# ─────────────────────────────────────────────
JWT_SECRET="your-strong-jwt-secret-minimum-32-chars"

# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
NODE_ENV="development"
PORT=4000

# Comma-separated list of allowed CORS origins
# In production: "https://app.yourdomain.com,https://admin.yourdomain.com"
ALLOWED_ORIGINS="http://localhost:3000"
APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────
# System Admin Seed (run once on first deploy)
# ─────────────────────────────────────────────
SYSTEM_ADMIN_EMAIL="admin@leadcrm.io"
SYSTEM_ADMIN_PASSWORD="change-this-immediately"

# ─────────────────────────────────────────────
# Gmail Integration
# ─────────────────────────────────────────────
GMAIL_CLIENT_ID="your-gmail-client-id"
GMAIL_CLIENT_SECRET="your-gmail-client-secret"
GMAIL_REDIRECT_URI="http://localhost:4000/api/v1/integrations/gmail/callback"

# ─────────────────────────────────────────────
# PayMongo
# ─────────────────────────────────────────────
PAYMONGO_SECRET_KEY="your-paymongo-secret-key"
PAYMONGO_PUBLIC_KEY="your-paymongo-public-key"
PAYMONGO_WEBHOOK_SECRET="your-paymongo-webhook-secret"
