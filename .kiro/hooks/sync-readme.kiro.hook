{
  "name": "Sync ReadMe-Kiro on .kiro Changes",
  "version": "1.0.0",
  "enabled": true,
  "description": "Whenever a file inside .kiro is created, edited, or deleted, automatically reviews ReadMe-Kiro.md and updates any sections that are now out of date.",
  "when": {
    "type": "fileEdited",
    "patterns": [
      ".kiro/hooks/*.hook",
      ".kiro/skills/*.md",
      ".kiro/steering/*.md",
      ".kiro/power/**"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file inside the .kiro folder was just modified. Review `.kiro/ReadMe-Kiro.md` and update any sections that are now out of date.\n\nCheck each section against the current state of .kiro:\n\n1. **Section 1 — Folder Structure**: Does the folder tree still match what exists?\n2. **Section 2 — Steering Files table**: Are all steering files listed with correct inclusion type and description?\n3. **Section 3 — Hooks table**: Are all hooks listed with correct trigger and description?\n4. **Section 4 — Skills table**: Are all skills listed with correct description?\n5. **Section 5 — Activation Header**: Is the header format still accurate?\n6. **Section 6 — Scenarios**: Do the scenarios still reflect how the system works?\n7. **Section 7 — Quick Reference**: Are the tables and never-do lists still accurate?\n\nOnly update sections that are actually out of date. Do not rewrite sections that are still correct. Keep all changes minimal and precise.\n\nIf ReadMe-Kiro.md is already fully up to date, say so briefly and make no changes."
  }
}
