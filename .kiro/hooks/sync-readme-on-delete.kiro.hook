{
  "name": "Sync ReadMe-Kiro on .kiro File Deleted",
  "version": "1.0.0",
  "enabled": true,
  "description": "Whenever a file is deleted from .kiro, automatically removes its entry from ReadMe-Kiro.md so the docs stay accurate.",
  "when": {
    "type": "fileDeleted",
    "patterns": [
      ".kiro/hooks/*.hook",
      ".kiro/skills/*.md",
      ".kiro/steering/*.md",
      ".kiro/power/**"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A file was just deleted from the .kiro folder. Update `.kiro/ReadMe-Kiro.md` to remove its entry.\n\nDetermine which section it was in based on its path:\n- `.kiro/hooks/` → Section 3 (Hooks table) — remove the row for this hook\n- `.kiro/skills/` → Section 4 (Skills table) — remove the row for this skill\n- `.kiro/steering/` → Section 2 (Steering Files table) — remove the row for this file\n- `.kiro/power/` → Section 4 (Power section) — update if manifest or structure changed\n\nAlso update Section 1 (Folder Structure) if the deletion changes the tree.\n\nKeep all changes minimal — only remove what is gone. Do not rewrite existing content."
  }
}
