{
  "name": "Activate AgentOS on Every Task",
  "version": "2.2.0",
  "enabled": true,
  "description": "Before any spec task begins, prints the activation header and runs a context scan.",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before starting this task: 1) Print the AgentOS activation header. 2) Read `.agent/memory/project-overview.md` and `.agent/README.md`. 3) Run Phase 0 — read the relevant files, map dependencies, identify risks. 4) Classify severity. 5) If HIGH or CRITICAL — write an Architecture Decision block before writing any code. Proceed with implementation following `.agent/` standards."
  }
}
