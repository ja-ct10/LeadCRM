{
  "name": "Activate AgentOS on Every Task",
  "version": "2.1.0",
  "enabled": true,
  "description": "Before any spec task begins, prints the activation header and classifies severity.",
  "when": {
    "type": "preTaskExecution"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Before starting: print the AgentOS activation header (agents used, skills active, severity, task type), then run Phase 0 context scan. Refer to project.md for the full AgentOS protocol."
  }
}
