{
  "enabled": true,
  "name": "Console Log Check",
  "description": "Flags console.log statements when JS/TS files are saved to prevent debug code from being committed.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A JS/TS file was just saved. Scan ONLY for console.log, console.warn, or console.info statements. If none exist, say nothing and stop. If found, remove them: replace with toast.error()/toast.success() where user feedback is needed, or delete if debug-only. Touch nothing else."
  }
}