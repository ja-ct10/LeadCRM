{
  "enabled": true,
  "name": "Console Log Check",
  "description": "Flags console.log statements when JS/TS files are saved to prevent debug code from being committed.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A JS/TS file was just saved. Check if it contains any console.log, console.warn, or console.info statements. If found, remove them and replace with appropriate toast.error() or toast.success() calls where user feedback is needed, or simply remove them if they were debug statements. Do not modify any other code."
  }
}