{
  "enabled": true,
  "name": "Quality Gate",
  "description": "Runs a full quality gate check manually — TypeScript, lint, and build verification before committing or creating a PR.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run the full LeadCRM quality gate. Read `.agent/checklists/production-ready.md` and related `.agent/checklists/` files. Work through each gate in sequence (TypeScript, Code Quality, SaaS Safety, Security, UI Quality) using the universal standards defined in `.agent/`. Report each gate as PASS or FAIL with specific issues. If all pass — confirm the task is ready to commit."
  }
}