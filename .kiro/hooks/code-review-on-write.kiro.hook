{
  "name": "code-review-on-write",
  "version": "1.3.0",
  "description": "Quick review after write operations. Checks for common security issues, SaaS safety gaps, and LeadCRM rule violations. NOTE: This hook fires postToolUse:write. The askAgent response must NOT write files — only report findings as text to avoid a circular trigger loop.",
  "when": { "type": "postToolUse", "toolTypes": ["write"] },
  "then": {
    "type": "askAgent",
    "prompt": "A file was just written or modified. Review ONLY — do NOT write or edit any files in this response.\n\nCheck the modified file for:\n- Missing tenantId on any new data records\n- Missing addAuditLog() on any create/update/delete operations\n- Missing RBAC guards on any create/edit/delete UI elements\n- Direct localStorage usage in components or hooks\n- any type, @ts-ignore, or inline style={{}}\n- framer-motion imports (should be motion/react)\n- Direct recharts imports (should be ChartComponents.tsx)\n- Raw <select> used as filter (should be TrelloFilter)\n- Missing dark mode classes on UI elements\n\nReport findings as a short bullet list only. If nothing is wrong, say 'No issues found.' in one line."
  }
}
