{
  "name": "Security Check on Sensitive Files",
  "version": "1.3.0",
  "description": "Shell-based secret scan when files are created in auth/api/middleware/store. Uses runCommand (zero credits).",
  "when": {
    "type": "fileCreated",
    "patterns": ["**/auth/**", "**/api/**", "**/middleware/**", "**/store/**"]
  },
  "then": {
    "type": "runCommand",
    "command": "powershell -Command \"Write-Host '[Security Scan]'; $matches = Select-String -Path '${file}' -Pattern '(password|secret|apiKey|api_key|token)\\s*=\\s*[''`\"][^''`\"]{6,}[''`\"]' -AllMatches; if ($matches) { Write-Host 'WARNING: Possible hardcoded secret found:'; $matches | ForEach-Object { Write-Host $_.Line } } else { Write-Host 'No hardcoded secrets detected.' }\""
  }
}
