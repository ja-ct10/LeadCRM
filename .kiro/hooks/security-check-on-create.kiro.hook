{
  "name": "Security Check on Sensitive Files",
  "version": "1.1.0",
  "description": "Security review when files are created in auth/api/middleware/store.",
  "when": {
    "type": "fileCreated",
    "patterns": ["**/auth/**", "**/api/**", "**/middleware/**", "**/store/**"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A new file was just created. Review ONLY — do NOT write or edit any files in this response. Read `.agent/checklists/security.md`. Check for: hardcoded secrets, missing RBAC/tenantId guards (if applicable), and unsafe data practices. Report findings as a short bullet list only. If nothing is wrong, say 'No security issues found.' in one line."
  }
}
